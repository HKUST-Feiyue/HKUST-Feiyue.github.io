{
  "categories": [
    {
      "id": "further-studies",
      "reviewTeam": "further-studies-reviewers",
      "label": "升学深造",
      "description": "升学准备与求学经历"
    },
    {
      "id": "research",
      "reviewTeam": "research-reviewers",
      "label": "学术科研",
      "description": "研究实践与学术探索"
    },
    {
      "id": "career",
      "reviewTeam": "career-reviewers",
      "label": "职业发展",
      "description": "实习、求职与职业成长"
    },
    {
      "id": "exchange",
      "reviewTeam": "exchange-reviewers",
      "label": "交流访学",
      "description": "交流项目与访学经历"
    },
    {
      "id": "entrepreneurship",
      "reviewTeam": "entrepreneurship-reviewers",
      "label": "创新创业",
      "description": "创业实践与项目探索"
    }
  ],
  "fields": [
    {
      "name": "author",
      "label": "姓名 / 昵称",
      "type": "text",
      "required": true,
      "maxLength": 60,
      "placeholder": "例如 陈同学 / Alex"
    },
    {
      "name": "campus",
      "label": "校园",
      "type": "radio",
      "required": true,
      "options": [
        {
          "value": "hk",
          "label": "香港校园"
        },
        {
          "value": "gz",
          "label": "广州校园"
        }
      ],
      "placeholder": "请选择校园"
    },
    {
      "name": "year",
      "label": "入学年份",
      "type": "text",
      "required": true,
      "maxLength": 4,
      "inputMode": "numeric",
      "pattern": "[0-9]{4}",
      "placeholder": "例如 2026",
      "hint": "按实际入学公历年份填写，不是学年或毕业年份。"
    },
    {
      "name": "term",
      "label": "入学季",
      "type": "select",
      "required": true,
      "placeholder": "请选择",
      "options": [
        {
          "value": "fall",
          "label": "Fall"
        },
        {
          "value": "spring",
          "label": "Spring"
        }
      ]
    },
    {
      "name": "degree",
      "label": "学位类型",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "BSc",
          "label": "BSc",
          "group": "本科"
        },
        {
          "value": "BEng",
          "label": "BEng",
          "group": "本科"
        },
        {
          "value": "BBA",
          "label": "BBA",
          "group": "本科"
        },
        {
          "value": "MSc",
          "label": "MSc",
          "group": "授课型研究生"
        },
        {
          "value": "MA",
          "label": "MA",
          "group": "授课型研究生"
        },
        {
          "value": "MEng",
          "label": "MEng",
          "group": "授课型研究生"
        },
        {
          "value": "MFA",
          "label": "MFA",
          "group": "授课型研究生"
        },
        {
          "value": "MBA",
          "label": "MBA",
          "group": "授课型研究生"
        },
        {
          "value": "EMBA",
          "label": "EMBA",
          "group": "授课型研究生"
        },
        {
          "value": "MPP",
          "label": "MPP",
          "group": "授课型研究生"
        },
        {
          "value": "MPM",
          "label": "MPM",
          "group": "授课型研究生"
        },
        {
          "value": "DBA",
          "label": "DBA",
          "group": "授课型研究生"
        },
        {
          "value": "PGD",
          "label": "PGD",
          "group": "授课型研究生"
        },
        {
          "value": "MPhil",
          "label": "MPhil",
          "group": "研究型研究生"
        },
        {
          "value": "PhD",
          "label": "PhD",
          "group": "研究型研究生"
        },
        {
          "value": "Other",
          "label": "Other",
          "group": "其他"
        }
      ],
      "placeholder": "请选择学位类型"
    },
    {
      "name": "field",
      "label": "专业 / 研究方向",
      "type": "text",
      "required": true,
      "maxLength": 100,
      "placeholder": "例如 Computer Science / Embodied AI"
    },
    {
      "name": "category",
      "label": "分享方向",
      "type": "select",
      "required": true,
      "placeholder": "请选择分享方向"
    },
    {
      "name": "destination",
      "label": "去向",
      "type": "text",
      "required": true,
      "maxLength": 160,
      "placeholder": "例如 院校、企业、研究机构或项目名称",
      "placeholders": {
        "further-studies": "例如 University of Cambridge",
        "research": "例如 MIT CSAIL",
        "career": "例如 Microsoft",
        "exchange": "例如 National University of Singapore",
        "entrepreneurship": "例如 创业公司或项目名称"
      }
    },
    {
      "name": "body",
      "label": "经历正文",
      "type": "textarea",
      "required": true,
      "maxLength": 8000,
      "placeholder": "分享你的准备过程、关键经历、收获与建议……",
      "hint": "支持普通文字与 Markdown，可载入示例并预览。"
    },
    {
      "name": "contact",
      "label": "联系方式",
      "type": "contacts",
      "required": false,
      "maxItems": 10,
      "typeMaxLength": 60,
      "valueMaxLength": 500,
      "hint": "仅填写愿意公开的联系方式；GitHub Issue 和发布后的文章都会公开。",
      "typePlaceholder": "例如 微信 / Email",
      "valuePlaceholder": "例如 example_id / hello@example.com"
    }
  ]
}
